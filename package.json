{
  "name": "vampire-survivors-progress",
  "version": "0.1.0",
  "description": "Offline single-page app that reads a Vampire Survivors save file and shows progress.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "node --test --experimental-transform-types 'test/**/*.test.ts'",
    "catalog": "node --experimental-transform-types tools/build-catalog.ts",
    "sample": "node --experimental-transform-types tools/make-sample-save.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.48.2",
    "@sveltejs/vite-plugin-svelte": "6.2.1",
    "@types/node": "24.10.1",
    "svelte": "5.42.2",
    "svelte-check": "4.3.4",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
